<?xml version="1.0" encoding="utf-8"?>
<Mapping Space="C-S" xmlns="http://schemas.microsoft.com/ado/2009/11/mapping/cs">
  <EntityContainerMapping StorageEntityContainer="PlantsDatabaseModelStoreContainer" CdmEntityContainer="PlantsDatabaseEntities">
    <EntitySetMapping Name="plantas">
      <EntityTypeMapping TypeName="PlantsDatabaseModel.plantas">
        <MappingFragment StoreEntitySet="plantas">
          <ScalarProperty Name="id" ColumnName="id" />
          <ScalarProperty Name="name" ColumnName="name" />
          <ScalarProperty Name="description" ColumnName="description" />
          <ScalarProperty Name="formatoFolha" ColumnName="formatoFolha" />
          <ScalarProperty Name="pontaFolha" ColumnName="pontaFolha" />
          <ScalarProperty Name="tipoFlor" ColumnName="tipoFlor" />
          <ScalarProperty Name="tipoHaste" ColumnName="tipoHaste" />
          <ScalarProperty Name="tipoFruta" ColumnName="tipoFruta" />
          <ScalarProperty Name="waterDays" ColumnName="waterDays" />
          <ScalarProperty Name="fertilizationMonth" ColumnName="fertilizationMonth" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="plantasUsuarios">
      <EntityTypeMapping TypeName="PlantsDatabaseModel.plantasUsuarios">
        <MappingFragment StoreEntitySet="plantasUsuarios">
          <ScalarProperty Name="user_id" ColumnName="user_id" />

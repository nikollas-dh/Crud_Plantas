        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="TtipoFlor">
      <EntityTypeMapping TypeName="PlantsDatabaseModel.TtipoFlor">
        <MappingFragment StoreEntitySet="TtipoFlor">
          <ScalarProperty Name="id" ColumnName="id" />
          <ScalarProperty Name="name" ColumnName="name" />
        </MappingFragment>
      </EntityTypeMapping>
    </EntitySetMapping>
    <EntitySetMapping Name="TtipoFruta">
      <EntityTypeMapping TypeName="PlantsDatabaseModel.TtipoFruta">
